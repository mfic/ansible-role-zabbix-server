# {{ ansible_managed }}
#
# cloudflared configuration. Rendered by mfic.zabbix_server — DO NOT EDIT ON THE
# HOST, the next run overwrites it.
#
# This tunnel is LOCALLY managed: the ingress rules below are the routing, and
# they are in version control. A tunnel configured with a dashboard token routes
# by rules held remotely instead — which works, but means a rebuild from this
# repo produces a tunnel that serves nothing until somebody remembers.

tunnel: {{ zabbix_server_cloudflared_tunnel_id }}
credentials-file: /etc/cloudflared/credentials.json

# ⚠ Must be set explicitly, and the container healthcheck depends on it:
# `cloudflared tunnel ready` queries this endpoint, and without a fixed address
# the metrics server binds a random port that nothing can then ask.
metrics: 0.0.0.0:{{ zabbix_server_cloudflared_metrics_port }}

# Suppress the "please update" nag. The image tag is pinned; upgrading is a
# variable change and a diff, not something the binary decides.
no-autoupdate: true

ingress:
  - hostname: {{ zabbix_server_cloudflared_hostname }}
    # Straight to the frontend over the Compose network. Cloudflare terminates
    # TLS at its edge, so this hop is plaintext INSIDE the bridge network on a
    # single host, and asking for a certificate here would mean issuing one for
    # a name whose entire purpose is being reachable without the LAN.
    service: http://zabbix-web:8080
    originRequest:
      # The frontend answers on a name it does not know it has; send the public
      # hostname so PHP builds redirects that point back at the tunnel rather
      # than at the container name.
      httpHostHeader: {{ zabbix_server_cloudflared_hostname }}

  # ⚠ MANDATORY, and cloudflared refuses to start without it. A catch-all that
  # answered instead of 404 would publish this frontend under any hostname
  # pointed at the tunnel, which is the one thing an access-controlled front
  # door must not do.
  - service: http_status:404
