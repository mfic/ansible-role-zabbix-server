# {{ ansible_managed }}
#
# Compose reads this automatically from the project directory. The database
# password lives HERE and not in compose_pgsql.yaml.j2 for two reasons: the
# compose file is a reviewable artifact that should be diffable in full without
# leaking a credential, and this file can be 0600 root-only while the compose
# file stays readable.
#
# compose_pgsql.yaml.j2 references it as ${POSTGRES_PASSWORD:?...}, so a missing
# or empty value stops `docker compose up` with a named error instead of
# starting PostgreSQL with trust auth or an empty password.
POSTGRES_PASSWORD={{ zabbix_server_db_password }}
