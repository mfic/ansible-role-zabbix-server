#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
#
# Rendered by mfic.zabbix_server. DO NOT EDIT ON THE HOST — the next run
# overwrites it.
#
# Modelled on zabbix/zabbix-docker `compose_pgsql.yaml` (branch
# {{ zabbix_server_compose_ref }}), rendered rather than checked out: the upstream upgrade
# procedure is `git pull` + `up -d`, which overwrites local edits and offers no
# rollback. Rendering makes the file a function of this role's variables, so an
# upgrade is a version bump in the inventory and a diff you can read first.
#
# ⚠ EVERY PERSISTENT PATH IS AN EXPLICIT BIND MOUNT under
# {{ zabbix_server_data_dir }}, which is its own filesystem. Upstream uses named
# volumes; that was rejected deliberately. A named volume lives under Docker's
# data-root, so a rebuild that loses the volume — or a data-root that quietly
# moved — recreates it EMPTY, PostgreSQL initialises a fresh cluster, Zabbix
# rebuilds its schema, and the whole stack comes up green with no history. Bind
# mounts make the path visible to `ls`, checkable by `findmnt`, and readable by
# a backup job that is not Docker.

services:
  postgres:
    image: {{ zabbix_server_db_image }}
    container_name: {{ zabbix_server_db_container_name }}
    restart: {{ zabbix_server_restart_policy }}
    # ⚠ The bind target is /var/lib/postgresql/data, NOT /var/lib/postgresql.
    # Mounting the parent leaves the real data directory inside an ANONYMOUS
    # volume that disappears on the next `up --force-recreate` — the second
    # silent route to an empty database.
    volumes:
      - {{ zabbix_server_data_dir }}/postgresql/data:/var/lib/postgresql/data
{% if zabbix_server_backup_enabled | bool %}
      # Read-WRITE, and both directions are used: pg_dump writes the nightly
      # archive here, and pg_restore reads it back during a recovery. A restore
      # that cannot see the dump from inside the container is a restore that does
      # not happen, which is the failure this mount exists to prevent.
      - {{ zabbix_server_backup_dir }}:{{ zabbix_server_backup_container_dir }}
{% endif %}
    environment:
      POSTGRES_USER: {{ zabbix_server_db_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is unset — refusing to start}
      POSTGRES_DB: {{ zabbix_server_db_name }}
      # Belt and braces against the mount landing one level too high: if the
      # bind is wrong, initdb writes here and PG_VERSION is absent from the
      # path the pre-flight guard stats, so the NEXT run refuses.
      PGDATA: /var/lib/postgresql/data
    # Upstream sets no shm_size at all, leaving Docker's 64 MB default. Parallel
    # query workers and large sorts allocate there and fail when it is short.
    shm_size: {{ zabbix_server_db_shm_size }}
    # Upstream ships 1m. The postgres image's STOPSIGNAL is SIGINT (fast
    # shutdown); a hard kill mid-checkpoint is the other silent-corruption
    # route, and the image's own guidance warns 90s may not be enough.
    stop_grace_period: {{ zabbix_server_db_stop_grace_period }}
    # pg_isready ships in this image, so this healthcheck is verified rather
    # than assumed — which matters because zabbix-server gates on it below.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ zabbix_server_db_user }} -d {{ zabbix_server_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
    networks:
      - zabbix

  zabbix-server:
    image: zabbix/zabbix-server-pgsql:{{ zabbix_server_image_flavour }}-{{ zabbix_server_version }}
    container_name: zabbix-server
    restart: {{ zabbix_server_restart_policy }}
    # service_healthy, not service_started: the server's entrypoint creates the
    # schema, and racing initdb is how a half-built database happens.
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DB_SERVER_HOST: postgres
      DB_SERVER_PORT: "5432"
      POSTGRES_USER: {{ zabbix_server_db_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is unset — refusing to start}
      POSTGRES_DB: {{ zabbix_server_db_name }}
      # Upstream default is "Composed installation" — it is what the frontend
      # header and every email subject line says.
      ZBX_SERVER_NAME: "{{ zabbix_server_name }}"
      ZBX_ENABLE_SNMP_TRAPS: "{{ zabbix_server_enable_snmp_traps | bool | lower }}"
      ZBX_JAVAGATEWAY_ENABLE: "{{ zabbix_server_enable_java_gateway | bool | lower }}"
      {% if zabbix_server_enable_java_gateway | bool %}
      ZBX_JAVAGATEWAY: zabbix-java-gateway
      {% endif %}
      ZBX_HOUSEKEEPINGFREQUENCY: "{{ zabbix_server_housekeeping_frequency }}"
      ZBX_MAXHOUSEKEEPERDELETE: "{{ zabbix_server_max_housekeeper_delete }}"
      {% if zabbix_server_cache_sizes %}
      # Set only when the inventory has a MEASURED reason to override. Empty by
      # default: there is no documented sizing formula, and an oversized cache
      # hides its own wrongness because the real working set never shows.
      {% for key, value in zabbix_server_cache_sizes | dictsort %}
      {{ key }}: "{{ value }}"
      {% endfor %}
      {% endif %}
      {% for key, value in zabbix_server_extra_env | dictsort %}
      {{ key }}: "{{ value }}"
      {% endfor %}
    # ⚠ Retention (history/trends) and the two housekeeping OVERRIDE flags are
    # NOT settable here. They live in the database as frontend settings, so they
    # are applied over the API after the stack is up — see the role's README.
    # There is no env var that can express them, and assuming otherwise is how
    # a documented retention policy ends up never actually applied.
    ports:
      - "{{ zabbix_server_listen_address }}:10051:10051"
    volumes:
      - {{ zabbix_server_data_dir }}/alertscripts:/usr/lib/zabbix/alertscripts:ro
      - {{ zabbix_server_data_dir }}/externalscripts:/usr/lib/zabbix/externalscripts:ro
      - {{ zabbix_server_data_dir }}/export:/var/lib/zabbix/export
      - {{ zabbix_server_data_dir }}/ssl/certs:/var/lib/zabbix/ssl/certs:ro
      - {{ zabbix_server_data_dir }}/ssl/keys:/var/lib/zabbix/ssl/keys:ro
      - {{ zabbix_server_data_dir }}/ssl/ssl_ca:/var/lib/zabbix/ssl/ssl_ca:ro
      {% if zabbix_server_enable_snmp_traps | bool %}
      - {{ zabbix_server_data_dir }}/snmptraps:/var/lib/zabbix/snmptraps:ro
      {% endif %}
    stop_grace_period: 30s
    sysctls:
      # fping runs setuid-less in this image and needs unprivileged ICMP.
      # Without it every ICMP check reports the host down — the same failure
      # that bites the Hetzner proxy (D16).
      - net.ipv4.ping_group_range=0 1995
    networks:
      - zabbix

  zabbix-web:
    image: zabbix/zabbix-web-nginx-pgsql:{{ zabbix_server_image_flavour }}-{{ zabbix_server_version }}
    container_name: zabbix-web
    restart: {{ zabbix_server_restart_policy }}
    depends_on:
      postgres:
        condition: service_healthy
      # ⚠ ORDERING AGAINST THE SERVER, not just the database, and dropping it
      # breaks the very first build. Both images will create the Zabbix schema
      # in an empty database, so starting them together races: one runs the DDL
      # while the other is midway through, the 203 tables end up present, the
      # seed data does not, and zabbix-server then crash-loops on
      #   cannot use database "zabbix": its "users" table is empty
      #     (is this the Zabbix proxy database?)
      # which names neither the real cause nor this container.
      #
      # Recovering costs a schema drop, so the ordering is what makes a first
      # build repeatable at all. Upstream's compose_pgsql.yaml carries this
      # dependency; it was lost when this file was rewritten from it.
      #
      # service_started, not service_healthy: the zabbix-server image ships no
      # healthcheck, so service_healthy would wait forever.
      zabbix-server:
        condition: service_started
    environment:
      DB_SERVER_HOST: postgres
      DB_SERVER_PORT: "5432"
      POSTGRES_USER: {{ zabbix_server_db_user }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is unset — refusing to start}
      POSTGRES_DB: {{ zabbix_server_db_name }}
      ZBX_SERVER_HOST: zabbix-server
      ZBX_SERVER_PORT: "10051"
      ZBX_SERVER_NAME: "{{ zabbix_server_name }}"
      # Upstream default is Europe/Riga. It decides every timestamp a human
      # reads in the UI and every one quoted in an alert.
      PHP_TZ: "{{ zabbix_server_php_tz }}"
    # ⚠ Bound to {{ zabbix_server_web_listen_address }} by default, i.e. NOT
    # published to the network. How the frontend is reached and how humans
    # authenticate is a separate decision; until it is taken, the safe default
    # is a port only reachable from the host itself.
    ports:
      - "{{ zabbix_server_web_listen_address }}:{{ zabbix_server_web_port }}:8080"
    stop_grace_period: 30s
    networks:
      - zabbix

  {% if zabbix_server_enable_java_gateway | bool %}
  zabbix-java-gateway:
    image: zabbix/zabbix-java-gateway:{{ zabbix_server_image_flavour }}-{{ zabbix_server_version }}
    container_name: zabbix-java-gateway
    restart: {{ zabbix_server_restart_policy }}
    stop_grace_period: 5s
    networks:
      - zabbix

  {% endif %}
  {% if zabbix_server_enable_snmp_traps | bool %}
  zabbix-snmptraps:
    image: zabbix/zabbix-snmptraps:{{ zabbix_server_image_flavour }}-{{ zabbix_server_version }}
    container_name: zabbix-snmptraps
    restart: {{ zabbix_server_restart_policy }}
    ports:
      - "{{ zabbix_server_listen_address }}:162:1162/udp"
    volumes:
      - {{ zabbix_server_data_dir }}/snmptraps:/var/lib/zabbix/snmptraps:rw
    stop_grace_period: 5s
    networks:
      - zabbix

  {% endif %}
  {% if zabbix_server_enable_traefik | bool %}
  # ⚠ NO Docker socket. Routing is rendered from role variables into
  # dynamic/zabbix.yaml and picked up by the file provider, because the only
  # backend is a fixed one that is already known when this file is written.
  # Label discovery would buy nothing here and would cost the daemon that runs
  # the database being controllable by the one container facing the network.
  traefik:
    image: {{ zabbix_server_traefik_image }}
    container_name: zabbix-traefik
    restart: {{ zabbix_server_restart_policy }}
    # The frontend must be answering before anything routes to it, or the first
    # request after a reboot meets a 502 from a proxy that started faster.
    depends_on:
      zabbix-web:
        condition: service_started
    # No `command:`. Every static setting lives in traefik.yaml, which is a file
    # a human can read and diff; flags here would be a second, invisible half of
    # the same configuration.
    ports:
      - "{{ zabbix_server_traefik_listen_address }}:{{ zabbix_server_traefik_http_port }}:80"
      - "{{ zabbix_server_traefik_listen_address }}:{{ zabbix_server_traefik_https_port }}:443"
    environment:
      # Read by lego's cloudflare provider. In the .env file, not here, so the
      # compose file stays diffable in full without leaking it.
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN:?CF_DNS_API_TOKEN is unset — refusing to start}
    volumes:
      - {{ zabbix_server_data_dir }}/traefik/traefik.yaml:/etc/traefik/traefik.yaml:ro
      - {{ zabbix_server_data_dir }}/traefik/dynamic:/etc/traefik/dynamic:ro
      # ⚠ acme.json holds the private key and must be 0600. Traefik refuses to
      # start otherwise -- which is the correct behaviour, and the reason this
      # is a bind mount to a file the role creates with that mode rather than a
      # directory Docker would create as 0755 root.
      - {{ zabbix_server_data_dir }}/traefik/acme/acme.json:/etc/traefik/acme/acme.json
    stop_grace_period: 30s
    networks:
      - zabbix

  {% endif %}
  {% if zabbix_server_enable_cloudflared | bool %}
  # Outbound-only: the tunnel dials the Cloudflare edge, so nothing inbound is
  # opened on this host or its firewall for the public path.
  #
  # ⚠ ON THE COMPOSE NETWORK, not `network_mode: host`. The reference compose
  # this was modelled on uses host networking, which is right for a connector
  # that fronts arbitrary things on the host — but here it would mean reaching
  # the frontend through its 127.0.0.1 publish, and that publish is the
  # BREAK-GLASS path. Coupling the public route to the emergency route means one
  # change can take both away. On the bridge network the two stay independent.
  #
  # ⚠ CONSEQUENCE FOR THE DASHBOARD: the tunnel's public hostname must point at
  # `http://zabbix-web:8080`, resolved by Docker on this network — NOT at
  # localhost. A dashboard entry pointing at 127.0.0.1 reaches the CONTAINER's
  # own loopback, where nothing is listening, and every request 502s while the
  # tunnel itself reports perfectly healthy.
  cloudflared:
    image: {{ zabbix_server_cloudflared_image }}
    container_name: zabbix-cloudflared
    restart: {{ zabbix_server_restart_policy }}
    depends_on:
      zabbix-web:
        condition: service_started
    # Token-configured, so there is no config file and no credentials file to
    # mount -- the connector fetches its ingress rules from Cloudflare. The
    # image's entrypoint is already `cloudflared --no-autoupdate`, so this
    # appends to it rather than repeating it.
    #
    # ⚠ --metrics is a TUNNEL command option and must sit between `tunnel` and
    # `run`. It is not decoration: the healthcheck below queries this address,
    # and left unset the metrics server binds a port nothing can find.
    command: tunnel --metrics 0.0.0.0:{{ zabbix_server_cloudflared_metrics_port }} run
    environment:
      # The whole credential -- account, tunnel id and secret in one string.
      # Lives in .env at 0600, not here, so the compose file stays diffable.
      TUNNEL_TOKEN: ${TUNNEL_TOKEN:?TUNNEL_TOKEN is unset — refusing to start}
    # `ready` reports the state of the connections to the edge, so this is a
    # healthcheck of the TUNNEL and not merely of the process. A cloudflared
    # that is running but has no registered connection serves nothing while
    # looking entirely alive to `docker ps`.
    #
    # ⚠ --metrics is a TUNNEL command option, so it goes between `tunnel` and
    # `ready`. Placed anywhere else it is rejected, and the healthcheck then
    # fails for a reason that has nothing to do with the tunnel's state.
    healthcheck:
      test: ["CMD", "cloudflared", "tunnel", "--metrics", "127.0.0.1:{{ zabbix_server_cloudflared_metrics_port }}", "ready"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    stop_grace_period: 30s
    networks:
      - zabbix

  {% endif %}
networks:
  zabbix:
    name: zabbix
    driver: bridge
